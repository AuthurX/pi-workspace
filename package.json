{
  "name": "@ellieyujin/pi-reopen",
  "license": "MIT",
  "version": "0.2.0-dev.1",
  "description": "Restore recorded Pi sessions in Windows WezTerm tabs from WSL; includes a Pi extension and standalone CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AuthurX/pi-workspace.git"
  },
  "homepage": "https://github.com/AuthurX/pi-workspace#readme",
  "bugs": {
    "url": "https://github.com/AuthurX/pi-workspace/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "workspace",
    "wezterm",
    "wsl"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "bin",
    "README.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/open-all.ts"
    ],
    "image": "https://raw.githubusercontent.com/AuthurX/pi-workspace/main/assets/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "bin": {
    "pi-workspace": "bin/pi-workspace.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  }
}
